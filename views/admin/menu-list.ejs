<%- include('../partials/header') %>

<div class="content-header">
  <h1><i class="fa-solid fa-list-check"></i> Menu Management</h1>
  <a href="/admin/add-menu" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Add New Item</a>
</div>

<div class="card card-table">
  <% if (menuItems.length === 0) { %>
    <div class="empty-state">
      <i class="fa-solid fa-mug-hot"></i>
      <p>No menu items found. Get started by adding some delicious coffee or food!</p>
      <a href="/admin/add-menu" class="btn btn-primary btn-sm">Add Item</a>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Stock Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% menuItems.forEach(function(item) { %>
            <tr>
              <td class="font-semibold"><%= item.name %></td>
              <td>
                <span class="category-badge">
                  <%= item.category %>
                </span>
              </td>
              <td class="price-cell">₹<%= item.price %></td>
              <td>
                <% if (item.isAvailable) { %>
                  <span class="status-badge status-success">In Stock</span>
                <% } else { %>
                  <span class="status-badge status-danger">Out of Stock</span>
                <% } %>
              </td>
              <td>
                <div class="actions-group">
                  <a href="/admin/menu/edit/<%= item._id %>" class="btn btn-icon btn-edit" title="Edit Item">
                    <i class="fa-solid fa-pen"></i> Edit
                  </a>
                  <form action="/admin/menu/delete/<%= item._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this menu item?');" class="inline-form">
                    <button type="submit" class="btn btn-icon btn-delete" title="Delete Item">
                      <i class="fa-solid fa-trash-can"></i> Delete
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>