<%- include('../partials/header') %>

<div class="content-header">
  <h1><i class="fa-solid fa-pen-to-square"></i> Edit Menu Item</h1>
  <a href="/admin/menu" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Back to Menu</a>
</div>

<div class="card-form-container">
  <div class="card card-form">
    <form action="/admin/menu/edit/<%= menuItem._id %>" method="POST">
      <div class="form-group">
        <label for="name"><i class="fa-solid fa-tag"></i> Item Name</label>
        <input type="text" id="name" name="name" value="<%= menuItem.name %>" required>
      </div>

      <div class="form-group">
        <label for="category"><i class="fa-solid fa-filter"></i> Category</label>
        <select id="category" name="category" required>
          <% 
            const categories = ["Hot Coffee", "Cold Coffee", "Tea & Chai", "Bakery & Pastries", "Desserts", "Snacks"];
            categories.forEach(cat => {
              const selected = menuItem.category === cat ? 'selected' : '';
          %>
            <option value="<%= cat %>" <%= selected %>><%= cat %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="price"><i class="fa-solid fa-indian-rupee-sign"></i> Price (₹)</label>
        <input type="number" id="price" name="price" value="<%= menuItem.price %>" min="1" step="any" required>
      </div>

      <div class="form-group checkbox-group">
        <label for="isAvailable" class="checkbox-label">
          <input type="checkbox" id="isAvailable" name="isAvailable" <%= menuItem.isAvailable ? 'checked' : '' %>>
          <span class="checkbox-custom"></span>
          <span class="checkbox-text"><i class="fa-solid fa-circle-check"></i> Available in Stock</span>
        </label>
      </div>

      <button type="submit" class="btn btn-primary btn-block">
        <i class="fa-solid fa-arrows-rotate"></i> Update Menu Item
      </button>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>